<?xml version="1.0" encoding="UTF-8"?>
<package name="de.classic-computing.archive-link" xmlns="http://www.woltlab.com" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.woltlab.com http://www.woltlab.com/XSD/6.0/package.xsd">
	<packageinformation>
		<packagename>Archiv im Menü</packagename>
		<packagename language="en">Archive in the menu</packagename>
		<packagedescription>Seite „Archiv“, die direkt auf archiv.classic-computing.de weiterleitet. Ein Menüpunkt auf diese Seite erscheint nur für Benutzer mit Archivzugang und öffnet das Archiv in einem neuen Tab.</packagedescription>
		<packagedescription language="en">Page "Archiv" that redirects straight to archiv.classic-computing.de. A menu item linking to it shows only for users with archive access and opens the archive in a new tab.</packagedescription>
		<version>1.0.0</version>
		<date>2026-11-13</date>
	</packageinformation>

	<authorinformation>
		<author>VzEkC e. V.</author>
		<authorurl>https://forum.classic-computing.de</authorurl>
	</authorinformation>

	<requiredpackages>
		<requiredpackage minversion="6.2.0">com.woltlab.wcf</requiredpackage>
		<!-- provides the group permission user.archive.canAccess -->
		<requiredpackage minversion="1.3.0">de.vzekc.archiv.einreichen</requiredpackage>
	</requiredpackages>

	<excludedpackages>
		<excludedpackage version="6.3.0 Alpha 1">com.woltlab.wcf</excludedpackage>
	</excludedpackages>

	<instructions type="install">
		<instruction type="file" />
		<instruction type="page" />
		<instruction type="templateListener" />
	</instructions>

	<instructions type="update" fromversion="1.0.*">
		<instruction type="file" />
		<instruction type="page" />
		<instruction type="templateListener" />
	</instructions>
</package>
